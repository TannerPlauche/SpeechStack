{
  "expo": {
    "name": "SpeechStack",
    "slug": "speechStack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speechstack.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "SpeechStack connects to the Vowelsy server to upload practice recordings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.speechstack.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9EF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SpeechStack records practice words so you can play them back and measure the speech sounds.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/with-scene-lifecycle"
    ],
    "scheme": "speechstack",
    "backgroundColor": "#FFF9EF",
    "experiments": {
      "typedRoutes": true
    }
  }
}
